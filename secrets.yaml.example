# Copy this file to secrets.yaml or keep the same content there. Export every
# named environment variable before running ESPHome. Never commit real values.
wifi_ssid: !env_var JK_BMS_WIFI_SSID
wifi_password: !env_var JK_BMS_WIFI_PASSWORD
jk_bms_api_key: !env_var JK_BMS_API_KEY
jk_bms_ap_password: !env_var JK_BMS_AP_PASSWORD
jk_bms_ota_password: !env_var JK_BMS_OTA_PASSWORD
jk_bms_web_username: !env_var JK_BMS_WEB_USERNAME
jk_bms_web_password: !env_var JK_BMS_WEB_PASSWORD
