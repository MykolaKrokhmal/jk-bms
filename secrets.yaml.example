# Copy this file to secrets.yaml (which is, and must stay, gitignored --
# see .gitignore) and fill in real, unique values before flashing. Every
# value below is a PLACEHOLDER -- none of these are usable credentials.
#
# Per ESPHome's own security_best_practices guide: each device must have
# its own unique API encryption key, OTA password, and web-server
# credentials. Only Wi-Fi credentials may be shared across devices on the
# same network.

# --- Wi-Fi (existing, unchanged) ---
wifi_ssid: "YourWifiNetworkName"
wifi_password: "YourWifiPassword"

# --- Native API encryption key (existing, unchanged) ---
# Generate with: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
jk_bms_api_key: "REPLACE_WITH_A_GENERATED_32_BYTE_BASE64_KEY="

# --- New: fallback AP password ---
# Replaces the hardcoded "change-this-password" placeholder that was
# previously checked into batterylifepo4.yaml directly. Long, unique,
# not reused from any other device or account.
jk_bms_ap_password: "REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"

# --- New: OTA password ---
# Required so an unauthenticated device on the network cannot push
# firmware. Never reuse across devices.
jk_bms_ota_password: "REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"

# --- New: Web UI (web_server.auth) credentials ---
# Basic auth in this ESPHome version (2026.6.5) -- Digest is not available
# in the schema this version ships (verified against the installed
# package, not assumed); see the final report's version-compatibility
# section for the upgrade path if a newer ESPHome adds it later.
jk_bms_web_username: "REPLACE_WITH_A_USERNAME"
jk_bms_web_password: "REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
