{
  "$id": "protocol-blockers.schema.json",
  "$comment": "Schema for protocol/evidence/protocol_blockers.json (implementation plan typed-petting-puzzle, §1: 'Blocker/evidence register'). Human-authored, append-only, outside generated/. Validated by tools/protocol/lib/mini-schema.js — see that file for exactly which keywords are supported.",
  "type": "object",
  "required": ["schema_version", "blockers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter_id", "address", "issue", "evidence_needed", "owner",
          "closure_criterion", "status", "opened_date"
        ],
        "additionalProperties": false,
        "properties": {
          "parameter_id": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "pattern": "^0x[0-9A-F]{4}$" },
          "issue": { "type": "string", "minLength": 1 },
          "evidence_needed": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "closure_criterion": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["open", "closed"] },
          "opened_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "closed_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "resolution": { "type": "string" }
        }
      }
    }
  }
}
