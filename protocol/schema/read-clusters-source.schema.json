{
  "$id": "read-clusters-source.schema.json",
  "$comment": "Schema for protocol/read_clusters.canonical.json (clustered-read migration plan, M2). Structural rules only; coverage, overlap, straddle, credential and budget rules are semantic checks in tools/protocol/generate_read_clusters.js. Validated by tools/protocol/lib/mini-schema.js.",
  "type": "object",
  "required": ["$schema", "catalog_version", "generated_note", "operational_max_registers", "operational_max_note",
               "scheduling_allowance_rule", "clusters", "isolated_reads"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_note": { "type": "string", "minLength": 1 },
    "operational_max_registers": { "type": "integer", "minimum": 1, "maximum": 125 },
    "operational_max_note": { "type": "string", "minLength": 1 },
    "scheduling_allowance_rule": { "type": "string", "minLength": 1 },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cluster_id", "role", "start", "register_count", "cadence_ms", "active_cadence_ms", "phase_ms",
                     "freshness_budget_ms", "active_freshness_budget_ms", "sequence_after", "hardware_evidence"],
        "additionalProperties": false,
        "properties": {
          "cluster_id": { "type": "string", "pattern": "^[A-Z][0-9]$" },
          "role": { "type": "string", "enum": ["telemetry", "settings", "static"] },
          "start": { "type": "string", "pattern": "^0x[0-9A-F]{4}$" },
          "register_count": { "type": "integer", "minimum": 1, "maximum": 125 },
          "cadence_ms": { "type": "integer", "minimum": 100 },
          "active_cadence_ms": { "type": ["integer", "null"], "minimum": 100 },
          "phase_ms": { "type": "integer", "minimum": 0 },
          "freshness_budget_ms": { "type": "integer", "minimum": 1 },
          "active_freshness_budget_ms": { "type": ["integer", "null"], "minimum": 1 },
          "sequence_after": { "type": ["string", "null"], "pattern": "^[A-Z][0-9]$" },
          "hardware_evidence": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "isolated_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["read_id", "start", "register_count", "reason", "trigger"],
        "additionalProperties": false,
        "properties": {
          "read_id": { "type": "string", "pattern": "^[A-Z][0-9A-Z_]*$" },
          "start": { "type": "string", "pattern": "^0x[0-9A-F]{4}$" },
          "register_count": { "type": "integer", "minimum": 1, "maximum": 125 },
          "reason": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "enum": ["on_demand"] }
        }
      }
    }
  }
}
