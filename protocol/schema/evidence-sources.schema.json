{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$comment": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "type", "status", "claims_supported", "provenance_status", "derivation_group", "fingerprint"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "type": { "type": "string" },
          "status": { "enum": ["available", "unavailable"] },
          "claims_supported": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "provenance_status": { "enum": ["known", "partially_known", "unknown"] },
          "derivation_group": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": ["string", "null"] },
          "note": { "type": "string" },
          "sheet": { "type": "string" },
          "file_sha256": { "type": "string" },
          "acquisition_date": { "type": "string" },
          "provenance": { "type": "string" },
          "normalized_index": { "type": "string" },
          "normalized_index_generator": { "type": "string" },
          "input_filename": { "type": "string" },
          "repo_url": { "type": "string" },
          "file": { "type": "string" },
          "commit_sha": { "type": "string" },
          "commit_date": { "type": "string" },
          "commit_message": { "type": "string" },
          "license": { "type": "string" },
          "license_file": { "type": "string" },
          "notice_file": { "type": "string" },
          "runtime_dependency": { "type": "boolean" },
          "relationship": { "enum": ["upstream_reference"] },
          "derived_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "immutable_url": { "type": "string" },
          "local_copy_path": { "type": "string" },
          "local_copy_sha256": { "type": "string" },
          "locator_base": { "type": "string" },
          "implementation_files": { "type": "array", "items": { "type": "string" } },
          "document": { "type": "string" },
          "document_sha256": { "type": "string" },
          "session_scope": { "type": "string" },
          "deprecated": { "type": "boolean" },
          "superseded_by": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "authority_tier": { "enum": ["primary_protocol_spec", "normalized_implementation_spec", "secondary_implementation", "current_implementation", "hardware_capture"] }
        },
        "additionalProperties": false
      }
    }
  }
}
