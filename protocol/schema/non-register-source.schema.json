{
  "$id": "non-register-source.schema.json",
  "$comment": "Schema for protocol/non_register_entities.canonical.json — calculated ESPHome / ESP32-browser-UI / local-config entities that are NOT BMS registers (spec section 5.4).",
  "type": "object",
  "required": ["catalog_version", "entities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_note": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key", "category", "esphome_domain", "esphome_entity_id", "unit", "uk_display_unit", "en_display_unit",
          "frontend_label_uk", "frontend_label_en", "note"
        ],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "category": { "type": "string", "enum": ["calculated_esphome", "esp32_browser_ui", "local_config"] },
          "esphome_domain": {
            "type": ["string", "null"],
            "enum": ["sensor", "binary_sensor", "text_sensor", "number", "select", "text", null]
          },
          "esphome_entity_id": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "uk_display_unit": { "type": "string" },
          "en_display_unit": { "type": "string" },
          "frontend_label_uk": { "type": "string", "minLength": 1 },
          "frontend_label_en": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
